{
  "name": "W2 — Embedding question",
  "nodes": [
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const question = $json.body?.question;\n\nif (\n  typeof question !== \"string\" ||\n  question.trim().length < 3 ||\n  question.trim().length > 2000\n) {\n  throw new Error(\"La question doit contenir entre 3 et 2000 caractères.\");\n}\n\nreturn {\n  json: {\n    question: question.trim(),\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
