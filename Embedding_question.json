      "name": "Embedding question",
      "credentials": {
        "httpHeaderAuth": {
          "id": "0zcJqKdQwS2CrTEJ",
          "name": "Gemini API"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const embedding = $json.embedding?.values;\n\nif (\n  !Array.isArray(embedding) ||\n  embedding.length !== 768 ||\n  !embedding.every(\n    (value) => typeof value === \"number\" && Number.isFinite(value)\n  ) ||\n  !embedding.some((value) => Math.abs(value) > 1e-12)\n) {\n  throw new Error(\"Embedding de question invalide.\");\n}\n\nreturn {\n  json: {\n    modeleEmbedding: \"gemini-embedding-2\",\n    embedding,\n  },\n};"
      },
